<!--
  Physical DVD-Video launcher for the MiSTer DVD core.

  Install: copy this file to  /media/fat/_Physical Disc Cores/DVD.mgl
  and set <rbf> to the path of your DVD core .rbf (relative to /media/fat,
  without the date suffix — MiSTer picks the newest match). Examples:
      <rbf>_Console/DVD</rbf>
      <rbf>_Other/DVD</rbf>

  <setname>A0CD-DVD</setname> is what makes the fork auto-mount the disc in the
  drive when this launcher loads the core (the "A0CD-" prefix triggers
  physical_disc_launch_startup). The core's real name ("DVD") is unchanged, so
  is_dvd() still matches. Do not remove it.

  Once installed, the DVD core also appears in Auto Disc Detection: inserting a
  DVD-Video disc launches this .mgl automatically.
-->
<mistergamedescription>
	<rbf>_Console/DVD</rbf>
	<setname>A0CD-DVD</setname>
</mistergamedescription>
